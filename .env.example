# SOL AI Environment Configuration Template
# Copy this file to .env and fill in your secrets.

# LLM Provider Configuration ('mock' or 'gemini')
SOL_LLM_PROVIDER=mock

# Gemini Model Selection (default: gemini-2.5-flash)
SOL_GEMINI_MODEL=gemini-2.5-flash

# Google Gemini API Key (Obtain from Google AI Studio)
# Required ONLY if SOL_LLM_PROVIDER=gemini
GEMINI_API_KEY=
